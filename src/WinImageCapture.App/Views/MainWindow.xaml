<Window x:Class="WinImageCapture.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WinImageCapture.App.ViewModels"
        xmlns:views="clr-namespace:WinImageCapture.App.Views"
        Title="WinImageCapture" Height="720" Width="980" MinHeight="600" MinWidth="800">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="180" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Margin="0,0,0,8" FontWeight="Bold" Foreground="DarkRed"
                   Text="Warning: not running as administrator. DISM operations will fail."
                   Visibility="{Binding IsElevated, Converter={StaticResource InverseBoolToVisibilityConverter}}" />

        <TabControl Grid.Row="1">
            <TabItem Header="Capture Image">
                <views:CaptureView DataContext="{Binding Capture}" />
            </TabItem>
            <TabItem Header="Answer File">
                <views:AnswerFileView DataContext="{Binding AnswerFile}" />
            </TabItem>
            <TabItem Header="Apply / Deploy">
                <views:ApplyView DataContext="{Binding Apply}" />
            </TabItem>
        </TabControl>

        <GroupBox Grid.Row="2" Header="Log" Margin="0,8,0,0">
            <ListBox ItemsSource="{Binding LogLines}" FontFamily="Consolas" />
        </GroupBox>
    </Grid>
</Window>
