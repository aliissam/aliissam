<UserControl x:Class="WinImageCapture.App.Views.AnswerFileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Computer name" VerticalAlignment="Center" />
            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ComputerName, UpdateSourceTrigger=PropertyChanged}" Margin="4" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Organization" VerticalAlignment="Center" />
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Organization, UpdateSourceTrigger=PropertyChanged}" Margin="4" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Owner" VerticalAlignment="Center" />
            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Owner, UpdateSourceTrigger=PropertyChanged}" Margin="4" />

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Time zone" VerticalAlignment="Center" />
            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding TimeZone, UpdateSourceTrigger=PropertyChanged}" Margin="4" />

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Product key" VerticalAlignment="Center" />
            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding ProductKey, UpdateSourceTrigger=PropertyChanged}" Margin="4" />

            <TextBlock Grid.Row="5" Grid.Column="0" Text="Administrator password" VerticalAlignment="Center" />
            <PasswordBox Grid.Row="5" Grid.Column="1" x:Name="AdminPasswordBox" Margin="4" PasswordChanged="AdminPasswordBox_PasswordChanged" />

            <TextBlock Grid.Row="6" Grid.Column="0" Text="Local account name" VerticalAlignment="Center" />
            <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding LocalAccountName, UpdateSourceTrigger=PropertyChanged}" Margin="4" />

            <TextBlock Grid.Row="7" Grid.Column="0" Text="Local account password" VerticalAlignment="Center" />
            <PasswordBox Grid.Row="7" Grid.Column="1" x:Name="LocalPasswordBox" Margin="4" PasswordChanged="LocalPasswordBox_PasswordChanged" />

            <CheckBox Grid.Row="8" Grid.Column="1" Content="Enable auto logon" IsChecked="{Binding AutoLogon}" Margin="4" />
            <CheckBox Grid.Row="9" Grid.Column="1" Content="Hide EULA page" IsChecked="{Binding HideEulaPage}" Margin="4" />
            <CheckBox Grid.Row="10" Grid.Column="1" Content="Skip machine OOBE" IsChecked="{Binding SkipMachineOobe}" Margin="4" />
            <CheckBox Grid.Row="11" Grid.Column="1" Content="Skip user OOBE" IsChecked="{Binding SkipUserOobe}" Margin="4" />

            <TextBlock Grid.Row="12" Grid.Column="0" Text="First logon commands (one per line)" VerticalAlignment="Top" />
            <TextBox Grid.Row="12" Grid.Column="1" Text="{Binding FirstLogonCommands, UpdateSourceTrigger=PropertyChanged}" Margin="4"
                     AcceptsReturn="True" Height="80" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />

            <StackPanel Grid.Row="13" Grid.Column="1" Orientation="Horizontal" Margin="4,12,4,4">
                <Button Content="Save Answer File..." Command="{Binding SaveAnswerFileCommand}" Padding="16,6" Margin="0,0,8,0" />
            </StackPanel>

            <TextBlock Grid.Row="14" Grid.Column="0" Text="Inject into existing image" FontWeight="Bold" Margin="0,8,0,0" VerticalAlignment="Top" />
            <StackPanel Grid.Row="14" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="4,8,4,4">
                <TextBox Text="{Binding TargetWimPath, UpdateSourceTrigger=PropertyChanged}" Width="320" Margin="0,0,4,0" />
                <Button Content="Browse..." Command="{Binding BrowseTargetWimCommand}" Padding="8,2" Margin="0,0,4,0" />
                <TextBlock Text="Index:" VerticalAlignment="Center" Margin="8,0,4,0" />
                <TextBox Text="{Binding TargetImageIndex, UpdateSourceTrigger=PropertyChanged}" Width="40" Margin="0,0,8,0" />
                <Button Content="Inject" Command="{Binding InjectCommand}" Padding="16,6" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
